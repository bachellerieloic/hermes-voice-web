# Hermes Agent API server (enable it with API_SERVER_ENABLED=true and API_SERVER_KEY=... on the Hermes side)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me
# Model name to send; the Hermes API advertises "hermes-agent" on /v1/models
HERMES_MODEL=hermes-agent

# Nari Labs (https://docs.narilabs.com)
NARI_API_KEY=change-me
NARI_API_URL=https://api.narilabs.com
NARI_TTS_MODEL=qwen3-tts:free
NARI_VOICE=leon
NARI_STT_MODEL=qwen3-asr:free
NARI_LANGUAGE=en
# client: the browser's Silero VAD decides the end of turn and the gateway commits (default)
# server_vad: let Nari's server VAD decide (turn_detection {"type":"server_vad"})
NARI_TURN_DETECTION=client

# Shared secret the browser must present on the WebSocket upgrade (?token=). 16 chars minimum.
VOICE_TOKEN=change-me-to-a-long-random-string

# Bind address and port. Keep 127.0.0.1 and put nginx or Tailscale Serve in front.
HOST=127.0.0.1
PORT=8765

# Comma separated list of browser origins allowed to open the WebSocket.
# Empty means: only origins whose host matches the request Host header (works behind one reverse proxy).
ALLOWED_ORIGINS=

# Mount the app under a path prefix behind a reverse proxy, for example /voice. Empty for the root.
BASE_PATH=

# Set to true when a reverse proxy sets X-Forwarded-For, so the failed token rate limit is per client.
TRUST_PROXY=false

# The browser sends the token as the first WebSocket message, never in the URL. Set to true only for
# old clients that still pass ?token= on the upgrade (that value ends up in reverse proxy access logs).
ALLOW_QUERY_TOKEN=false

# Speak a short acknowledgement when Hermes takes longer than this before its first token.
ACK_DELAY_MS=1500
# Pipe-separated pool. One is picked at random each turn and never repeats the
# previous one, so the wait never sounds scripted. Use a single line to always
# say the same thing, or leave it empty (ACK_TEXT=) to stay silent until the answer.
ACK_TEXT=Right away.|One moment.|Let me check.|On it.|Looking into that.|Give me a second.|Checking now.|Working on it.

# Business awareness (optional, read only). Point these at an already-deployed endpoint that returns
# live business numbers as JSON; the gateway turns them into a short system note so the assistant can
# answer questions like "how were sessions this week" or "how much revenue". Leave the url or token
# empty to disable the feature entirely. No analytics logic runs here.
AGENT_SNAPSHOT_URL=
AGENT_SNAPSHOT_TOKEN=
# How long a fetched snapshot is cached before the next turn refetches it. Milliseconds, default 120000.
SNAPSHOT_TTL_MS=120000
# Set to true to request the upstream AI brief (?brief=1). It costs an LLM call upstream, so it is off
# by default.
AGENT_SNAPSHOT_BRIEF=false
